{%- comment -%}
  Beldor — carrousel d'avis clients avec photo.
  mode 'produit'  : avis photo du produit (product.metafields.bld.avis) ;
                    sans avis photo, avis photo de toute la boutique.
  mode 'boutique' : avis photo de toute la boutique (shop.metafields.bld.avis_photos).
  Paramètres : mode, product, title, subtitle, bg
  Défilement en boucle infinie : le script duplique les cartes de part et d'autre
  et recale la position sans saut visible, dans les deux sens.
{%- endcomment -%}
{%- liquid
  assign av_mode = mode | default: 'produit'
  assign av_fallback = false
  assign av_count = 0
  assign av_list = blank
  if av_mode == 'produit' and product != blank
    assign av_list = product.metafields.bld.avis.value
    for r in av_list
      assign r_n = r.note.value | plus: 0
      if r.photos.value.size > 0 and r_n >= 4 and r.masquer.value != true
        assign av_count = av_count | plus: 1
      endif
    endfor
  endif
  if av_count == 0
    assign av_list = shop.metafields.bld.avis_photos.value
    assign av_count = av_list.size | default: 0
    if av_mode == 'produit'
      assign av_fallback = true
    endif
  endif

  if av_mode == 'produit' and av_fallback == false
    assign h_val = product.metafields.reviews.rating.value.rating | default: 0 | plus: 0
    assign h_cnt = product.metafields.reviews.rating_count.value | default: 0 | plus: 0
  else
    assign h_val = shop.metafields.bld.note.value | default: 0 | plus: 0
    assign h_cnt = shop.metafields.bld.nb_avis.value | default: 0 | plus: 0
  endif
  assign h_txt = h_val | round: 1
  assign h_full = h_val | round

  if av_mode == 'boutique'
    assign av_anchor = 'bld-avis-boutique'
    assign d_title = 'Nos clients en photo'
    assign d_sub = 'Avis et photos de clients, sur toute la collection Beldor.'
    assign show_product = true
  elsif av_fallback
    assign av_anchor = 'bld-avis'
    assign d_title = 'Ils ont choisi Beldor'
    assign d_sub = 'Avis et photos de clients, sur toute la collection.'
    assign show_product = true
  else
    assign av_anchor = 'bld-avis'
    assign d_title = "Ils l'ont reçu chez eux"
    assign d_sub = 'Avis et photos de clients pour ce modèle.'
    assign show_product = false
  endif
  assign av_title = title | default: d_title
  assign av_sub = subtitle | default: d_sub
  assign av_bg = bg | default: '#ffffff'

  # En repli sur la page produit, le carrousel démarre à mi-liste pour ne pas
  # doubler celui affiché plus bas (au-dessus du comparatif).
  assign av_rotate = 0
  if av_fallback and av_count > 3
    assign av_rotate = av_count | divided_by: 2
  endif
-%}
{%- if av_count > 0 -%}
  <div class="bld-av" id="{{ av_anchor }}" data-bld-av style="background: {{ av_bg }};">
    <div class="bld-av__inner">
      <div class="bld-av__head">
        <p class="bld-av__kicker">Avis clients</p>
        <h2 class="bld-av__title">{{ av_title }}</h2>
        {%- if av_sub != blank -%}<p class="bld-av__sub">{{ av_sub }}</p>{%- endif -%}
        {%- if h_cnt > 0 -%}
          <div class="bld-av__score">
            <span class="bld-av__sq-row" aria-hidden="true">
              {%- for i in (1..5) -%}
                <span class="bld-av__sq{% if i > h_full %} is-off{% endif %}"><svg viewBox="0 0 24 24"><path d="M12 2.6l2.83 5.95 6.53.78-4.82 4.47 1.27 6.45L12 17.02l-5.81 3.23 1.27-6.45L2.64 9.33l6.53-.78z"/></svg></span>
              {%- endfor -%}
            </span>
            <span><strong>{{ h_txt }}/5</strong> · {{ h_cnt }} avis</span>
          </div>
        {%- endif -%}
      </div>

      <div class="bld-av__viewport">
        <button type="button" class="bld-av__nav bld-av__nav--prev" data-bld-av-prev aria-label="Avis précédents">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
        </button>
        <ul class="bld-av__track" data-bld-av-track role="list">
          {%- if av_rotate > 0 -%}
            {%- for r in av_list offset: av_rotate -%}{% render 'bld-avis-carte', r: r, show_product: show_product %}{%- endfor -%}
            {%- for r in av_list limit: av_rotate -%}{% render 'bld-avis-carte', r: r, show_product: show_product %}{%- endfor -%}
          {%- else -%}
            {%- for r in av_list -%}{% render 'bld-avis-carte', r: r, show_product: show_product %}{%- endfor -%}
          {%- endif -%}
        </ul>
        <button type="button" class="bld-av__nav bld-av__nav--next" data-bld-av-next aria-label="Avis suivants">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>

    <dialog class="bld-av__dialog" aria-label="Avis client">
      <button type="button" class="bld-av__close" data-bld-av-close aria-label="Fermer">&times;</button>
      <div data-bld-av-body></div>
    </dialog>
  </div>

  <style>
    .bld-av{padding:56px 0 60px;color:#23211e;--bld-av-gold:#a8916a;--bld-av-line:#ece5da;--bld-av-muted:#7a6a4e;--bld-av-serif:"Cormorant Garamond","Playfair Display",Didot,"Bodoni MT",Garamond,Georgia,serif}
    .bld-av *{box-sizing:border-box}
    .bld-av__inner{max-width:1300px;margin:0 auto;padding:0 32px}
    .bld-av__head{text-align:center;margin-bottom:30px}
    .bld-av__kicker{margin:0 0 9px;font-size:10.5px;font-weight:600;letter-spacing:.3em;text-indent:.3em;text-transform:uppercase;color:var(--bld-av-gold)}
    .bld-av__title{margin:0 0 9px;font-family:var(--bld-av-serif);font-weight:400;font-size:clamp(27px,3.6vw,40px);line-height:1.08;color:#23211e}
    .bld-av__sub{margin:0 auto 16px;max-width:56ch;font-size:15px;line-height:1.55;color:var(--bld-av-muted)}
    .bld-av__score{display:inline-flex;align-items:center;gap:10px;font-size:16px;color:#23211e}
    .bld-av__score strong{font-weight:600}
    .bld-av__sq-row{display:inline-flex;gap:3px;line-height:0}
    .bld-av__sq{display:grid;place-items:center;width:20px;height:20px;border-radius:3px;background:var(--bld-av-gold);color:#fff}
    .bld-av__sq svg{width:14px;height:14px;fill:currentColor}
    .bld-av__sq.is-off{background:#e4dccd}
    .bld-av__score .bld-av__sq{width:24px;height:24px}
    .bld-av__score .bld-av__sq svg{width:17px;height:17px}
    .bld-av__viewport{position:relative}
    .bld-av__track{list-style:none;margin:0;padding:6px 2px 14px;display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;-webkit-overflow-scrolling:touch}
    .bld-av__track::-webkit-scrollbar{display:none}
    .bld-av__card{flex:0 0 calc((100% - 54px) / 4);scroll-snap-align:start;display:flex;flex-direction:column;align-items:center;text-align:center;padding:22px 18px 20px;background:#fff;border:1px solid var(--bld-av-line);border-radius:14px;box-shadow:0 12px 30px -22px rgba(35,33,30,.35)}
    .bld-av__card > .bld-av__sq-row{margin-bottom:14px}
    .bld-av__text{margin:0 0 16px;font-size:14.5px;line-height:1.5;color:#3a362f;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;min-height:4.5em}
    .bld-av__media{position:relative;display:block;width:100%;aspect-ratio:4/5;margin:0;padding:0;border:0;border-radius:10px;overflow:hidden;background:#f4efe7;cursor:zoom-in}
    .bld-av__media img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .5s ease}
    .bld-av__media:hover img{transform:scale(1.04)}
    .bld-av__more{position:absolute;right:10px;bottom:10px;padding:4px 9px;border-radius:999px;background:rgba(35,33,30,.72);color:#fff;font-size:12px;font-weight:600;line-height:1.2}
    .bld-av__foot{margin-top:auto;padding-top:16px;display:grid;gap:4px}
    .bld-av__name{font-size:15px;font-weight:600;color:#23211e}
    .bld-av__prod{font-size:12.5px;color:var(--bld-av-muted);text-decoration:none;letter-spacing:.02em}
    .bld-av__prod:hover{text-decoration:underline;text-underline-offset:3px}
    .bld-av__nav{position:absolute;top:44%;z-index:2;display:grid;place-items:center;width:46px;height:46px;padding:0;border-radius:50%;border:1px solid var(--bld-av-line);background:#fff;color:#23211e;cursor:pointer;transform:translateY(-50%);box-shadow:0 10px 24px -12px rgba(35,33,30,.4);transition:opacity .2s}
    .bld-av__nav[disabled]{opacity:0;pointer-events:none}
    .bld-av__nav--prev{left:-18px}
    .bld-av__nav--next{right:-18px}
    .bld-av__nav svg{width:18px;height:18px}
    .bld-av__dialog{width:100%;max-width:min(940px,calc(100vw - 32px));max-height:calc(100vh - 48px);margin:auto;padding:0;border:0;border-radius:16px;overflow:auto;background:#fff;color:#23211e}
    .bld-av__dialog::backdrop{background:rgba(20,18,15,.62)}
    .bld-av__close{position:sticky;top:10px;float:right;z-index:3;width:40px;height:40px;margin:10px 10px 0 0;padding:0;border-radius:50%;border:1px solid var(--bld-av-line);background:#fff;color:#23211e;font-size:24px;line-height:1;cursor:pointer}
    .bld-av-full{display:grid;grid-template-columns:1.1fr 1fr}
    .bld-av-full__photos{display:grid;gap:6px;padding:6px;background:#f4efe7}
    .bld-av-full__photos img{display:block;width:100%;height:auto;border-radius:8px}
    .bld-av-full__body{padding:38px 32px;text-align:left}
    .bld-av-full__text{margin:16px 0 18px;font-size:15.5px;line-height:1.65;color:#23211e}
    .bld-av-full__name{margin:0 0 4px;font-weight:600}
    .bld-av-full__meta{margin:0;font-size:13.5px;color:var(--bld-av-muted)}
    .bld-av-full__meta a{color:inherit}
    @media (max-width:989px){.bld-av__card{flex-basis:calc((100% - 36px) / 3)}}
    @media (max-width:749px){
      .bld-av{padding:40px 0 44px}
      .bld-av__inner{padding:0}
      .bld-av__head{padding:0 16px;margin-bottom:22px}
      .bld-av__sub{font-size:13.5px}
      .bld-av__score{font-size:14.5px}
      .bld-av__track{gap:12px;padding:6px 16px 14px;scroll-padding:0 16px}
      .bld-av__card{flex-basis:76%;padding:18px 14px 16px}
      .bld-av__nav{display:none}
      .bld-av-full{grid-template-columns:1fr}
      .bld-av-full__body{padding:22px 18px 26px}
    }
  </style>

  <script>
    (function () {
      document.querySelectorAll('[data-bld-av]:not([data-bld-av-ready])').forEach(function (root) {
        root.setAttribute('data-bld-av-ready', '');
        var track = root.querySelector('[data-bld-av-track]');
        var prev = root.querySelector('[data-bld-av-prev]');
        var next = root.querySelector('[data-bld-av-next]');
        if (!track) return;
        var originaux = Array.prototype.slice.call(track.children);
        if (!originaux.length) return;

        function step() {
          var card = track.querySelector('li');
          var gap = parseFloat(getComputedStyle(track).columnGap) || 18;
          return card ? card.getBoundingClientRect().width + gap : 300;
        }

        /* --- Boucle infinie ---
           [ copie ] [ originaux (+ copies si peu d'avis) ] [ copie ]
           On reste toujours dans le bloc du milieu : arrivé au bout, on recale
           d'un bloc entier, à l'identique, donc sans aucun saut visible. */
        var unite = 0, largeurBuild = 0;
        function cloner(li) {
          var c = li.cloneNode(true);
          c.setAttribute('data-bld-av-clone', '');
          return c;
        }
        function origine() { return track.children[0].offsetLeft; }
        function base() { return originaux[0].offsetLeft - origine(); }
        function sauter(x) {
          track.style.scrollBehavior = 'auto';
          track.style.scrollSnapType = 'none';
          track.scrollLeft = x;
          void track.offsetWidth;
          requestAnimationFrame(function () {
            track.style.scrollBehavior = '';
            track.style.scrollSnapType = '';
          });
        }
        function construire() {
          var pas = step();
          var idx = 0;
          if (unite) idx = Math.round((track.scrollLeft - base()) / pas);
          Array.prototype.slice.call(track.querySelectorAll('[data-bld-av-clone]')).forEach(function (c) { c.remove(); });
          unite = 0;
          largeurBuild = track.clientWidth;
          var jeu = originaux.length * pas;
          if (!largeurBuild || !jeu) return;
          /* le bloc doit dépasser la largeur visible d'au moins 8 cartes,
             pour encaisser une rafale de clics sur les flèches */
          var reps = Math.max(1, Math.ceil((largeurBuild + 8 * pas) / jeu));
          for (var k = 1; k < reps; k++) originaux.forEach(function (li) { track.appendChild(cloner(li)); });
          var milieu = Array.prototype.slice.call(track.children);
          var apres = document.createDocumentFragment();
          var avant = document.createDocumentFragment();
          milieu.forEach(function (li) { apres.appendChild(cloner(li)); avant.appendChild(cloner(li)); });
          track.appendChild(apres);
          track.insertBefore(avant, track.firstChild);
          unite = track.children[milieu.length * 2].offsetLeft - track.children[milieu.length].offsetLeft;
          var n = milieu.length;
          idx = ((idx % n) + n) % n;
          sauter(base() + idx * pas);
        }
        var cible = null;
        function recadrer() {
          cible = null;
          if (!unite) return;
          var b = base(), x = track.scrollLeft;
          if (x < b - 1) sauter(x + unite);
          else if (x >= b + unite - 1) sauter(x - unite);
        }

        var minuterie = null;
        if ('onscrollend' in window) {
          track.addEventListener('scrollend', recadrer);
        } else {
          track.addEventListener('scroll', function () {
            clearTimeout(minuterie);
            minuterie = setTimeout(recadrer, 160);
          }, { passive: true });
        }
        /* chaque clic compte, même en rafale : on cumule la destination */
        function avancer(sens) {
          var depart = cible !== null ? cible : track.scrollLeft;
          cible = depart + sens * step();
          track.scrollTo({ left: cible, behavior: 'smooth' });
        }
        if (prev) prev.addEventListener('click', function () { avancer(-1); });
        if (next) next.addEventListener('click', function () { avancer(1); });

        var minuterieTaille = null;
        window.addEventListener('resize', function () {
          clearTimeout(minuterieTaille);
          minuterieTaille = setTimeout(function () {
            if (track.clientWidth && track.clientWidth !== largeurBuild) construire();
          }, 200);
        });
        construire();
        /* carrousel encore masqué au chargement (onglet, accordéon…) : on construit à l'affichage */
        if (!unite && 'IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entrees) {
            if (entrees.some(function (e) { return e.isIntersecting; }) && track.clientWidth) {
              construire();
              if (unite) io.disconnect();
            }
          });
          io.observe(track);
        }

        /* --- Avis en grand --- */
        var dialog = root.querySelector('dialog');
        var body = dialog && dialog.querySelector('[data-bld-av-body]');
        track.addEventListener('click', function (e) {
          var btn = e.target.closest('[data-bld-av-open]');
          if (!btn || !dialog) return;
          var tpl = btn.closest('li').querySelector('template');
          if (!tpl) return;
          body.innerHTML = '';
          body.appendChild(tpl.content.cloneNode(true));
          if (typeof dialog.showModal === 'function') dialog.showModal();
          else dialog.setAttribute('open', '');
        });
        if (dialog) {
          dialog.addEventListener('click', function (e) {
            if (e.target === dialog || e.target.closest('[data-bld-av-close]')) dialog.close();
          });
        }
      });
    })();
  </script>
{%- endif -%}
