{% comment %}
  Maison Philidor — « Voir chez moi » : l'échiquier en 3D, puis posé sur la table en réalité augmentée,
  à sa taille réelle. Les modèles (un par taille) sont dans Contenu > Fichiers (philidor-3d-*.glb).
  Le bloc gravure ouvre la même fenêtre, zoomée sur la plaque en laiton gravée au texte du client.
{% endcomment %}

{%- liquid
  assign p = closest.product | default: product
  capture liste
    render 'philidor-3d-modeles', handle: p.handle
  endcapture
  assign lignes = liste | strip | split: ';;'
  assign en = false
  if request.locale.iso_code == 'en'
    assign en = true
  endif
-%}

{%- if p != blank and lignes.size > 0 -%}
{%- capture carte -%}
  {%- for l in lignes -%}
    {%- assign c = l | split: '|' -%}
    "{{ c[0] | strip }}":{"src":{{ c[1] | strip | file_url | json }},"y":{{ c[2] }},"z":{{ c[3] }},"dims":{{ c[4] | strip | json }} }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
{%- endcapture -%}
{%- assign premiere = lignes | first | split: '|' -%}

<philidor-3d class="mph3d" data-variants="{{ '{' | append: carte | append: '}' | escape }}" data-default="{{ premiere[1] | strip | file_url }}" data-titre="{{ p.title | escape }}" {{ block.shopify_attributes }}>
  <button type="button" class="mph3d__open" data-ref="open">
    <span class="mph3d__cube" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M12 3 4 7.5v9L12 21l8-4.5v-9z"/><path d="M4 7.5 12 12l8-4.5M12 12v9"/></svg>
    </span>
    <span class="mph3d__txt">
      <strong>{% if en %}See it at home{% else %}Voir chez moi{% endif %}</strong>
      <span>{% if en %}In 3D, then on your own table at true size{% else %}En 3D, puis sur votre table, à taille réelle{% endif %}</span>
    </span>
    <span class="mph3d__ar" aria-hidden="true">AR</span>
  </button>

  <dialog class="mph3d__dlg" data-ref="dlg" aria-label="{% if en %}See it at home{% else %}Voir chez moi{% endif %}">
    <div class="mph3d__head">
      <div class="mph3d__head-t">
        <span class="mph3d__kicker">Maison Philidor · {% if en %}true size{% else %}taille réelle{% endif %}</span>
        <span class="mph3d__name">{{ p.title }}</span>
        <span class="mph3d__dims" data-ref="dims"></span>
      </div>
      <button type="button" class="mph3d__close" data-ref="close" aria-label="{% if en %}Close{% else %}Fermer{% endif %}">✕</button>
    </div>
    <div class="mph3d__stage" data-ref="stage">
      <p class="mph3d__wait" data-ref="wait">{% if en %}Loading the 3D board…{% else %}Préparation de l'échiquier en 3D…{% endif %}</p>
    </div>
    <div class="mph3d__foot">
      <p class="mph3d__tip">{% if en %}Turn it with one finger, zoom with two. On a phone, tap “Place it on my table” and aim at a flat surface.{% else %}Tournez-le d'un doigt, zoomez à deux doigts. Sur téléphone, touchez « Le poser sur ma table » et visez une surface plane.{% endif %}</p>
    </div>
  </dialog>
</philidor-3d>


{%- endif -%}

{% stylesheet %}
  .mph3d { display: block; margin: 4px 0 2px; }
  .mph-grav__3d {
    display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; margin-top: 12px;
    padding: 11px 14px; border: 1px solid var(--mph-walnut, #8a5a2b); border-radius: 10px;
    background: #fff; color: var(--mph-walnut, #8a5a2b); font: inherit; font-size: 14px; font-weight: 600; cursor: pointer;
    transition: background .15s, color .15s;
  }
  .mph-grav__3d:hover { background: var(--mph-walnut, #8a5a2b); color: #fff; }
  .mph-grav__3d[hidden] { display: none; }
  .mph3d__open {
    display: flex; align-items: center; gap: 12px; width: 100%;
    padding: 12px 14px; border: 1px solid #e3d8c6; border-radius: 12px;
    background: linear-gradient(180deg, #fffdf9, #fbf5ec); color: var(--mph-ink, #2a1b12);
    font: inherit; text-align: left; cursor: pointer;
    transition: border-color .2s, box-shadow .2s, transform .2s;
  }
  .mph3d__open:hover { border-color: #c9ab7e; box-shadow: 0 6px 18px -10px rgba(80,50,20,.45); }
  .mph3d__open:active { transform: scale(.99); }
  .mph3d__cube {
    flex: 0 0 auto; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 10px;
    background: var(--mph-walnut, #8a5a2b); color: #f6e7c8;
  }
  .mph3d__txt { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; line-height: 1.25; }
  .mph3d__txt strong { font-size: 15px; font-weight: 600; letter-spacing: .01em; }
  .mph3d__txt span { font-size: 12.5px; color: var(--mph-muted, #7b5e47); }
  .mph3d__ar {
    flex: 0 0 auto; font-size: 11px; font-weight: 700; letter-spacing: .12em; color: #8a5a2b;
    border: 1px solid #d9c3a0; border-radius: 99px; padding: 4px 9px; background: #fff;
  }
  .mph3d__dlg {
    width: min(980px, 100vw); height: min(760px, 100dvh); max-width: 100vw; max-height: 100dvh;
    padding: 0; border: 0; border-radius: 16px; overflow: hidden;
    background: #f4efe6; color: var(--mph-ink, #2a1b12);
    display: none; flex-direction: column;
  }
  .mph3d__dlg[open] { display: flex; }
  .mph3d__dlg::backdrop { background: rgba(28,18,10,.62); backdrop-filter: blur(2px); }
  @media (max-width: 749px) { .mph3d__dlg { width: 100vw; height: 100dvh; border-radius: 0; } }
  .mph3d__head { display: flex; align-items: flex-start; gap: 12px; padding: 14px 16px 10px; border-bottom: 1px solid #e6dccd; background: #fffaf2; }
  .mph3d__head-t { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
  .mph3d__kicker { font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: #b9853f; font-weight: 600; }
  .mph3d__name { font-size: 15px; font-weight: 600; line-height: 1.25; }
  .mph3d__dims { font-size: 12.5px; color: var(--mph-muted, #7b5e47); }
  .mph3d__close { flex: 0 0 auto; width: 36px; height: 36px; border-radius: 50%; border: 1px solid #e3d8c6; background: #fff; font-size: 15px; cursor: pointer; color: inherit; }
  .mph3d__stage { position: relative; flex: 1; min-height: 0; background: radial-gradient(ellipse at 50% 35%, #fbf7f0 0%, #ece3d4 75%); }
  .mph3d__stage model-viewer { width: 100%; height: 100%; --poster-color: transparent; --progress-bar-color: #8a5a2b; }
  .mph3d__wait { position: absolute; inset: 0; display: grid; place-items: center; margin: 0; font-size: 13.5px; color: #7b5e47; }
  .mph3d__arbtn {
    position: absolute; left: 50%; bottom: 16px; transform: translateX(-50%);
    display: inline-flex; align-items: center; gap: 8px; padding: 12px 20px; border: 0; border-radius: 99px;
    background: var(--mph-walnut, #8a5a2b); color: #fff; font: inherit; font-size: 14.5px; font-weight: 600;
    box-shadow: 0 10px 24px -10px rgba(60,35,10,.7); cursor: pointer; white-space: nowrap;
  }
  .mph3d__foot { padding: 10px 16px calc(12px + env(safe-area-inset-bottom, 0px)); border-top: 1px solid #e6dccd; background: #fffaf2; }
  .mph3d__tip { margin: 0; font-size: 12px; color: var(--mph-muted, #7b5e47); text-align: center; }
{% endstylesheet %}

{% schema %}
{
  "name": "Voir chez moi — 3D",
  "tag": null,
  "settings": [],
  "presets": [{ "name": "Voir chez moi — 3D", "category": "Maison Philidor" }]
}
{% endschema %}
