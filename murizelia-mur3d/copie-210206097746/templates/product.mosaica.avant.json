                "icon": "none",
                "icon_custom": "",
                "additional_class": ""
              },
              "blocks": {
                "d4t": {
                  "type": "text",
                  "settings": {
                    "show_on_display": "desktop_and_mobile",
                    "text": "<p>Non, il est important que la surface soit plate et non rugueuse.<br/><br/>Par exemple le carrelage, le verre, le stratifié ou encore les murs peints.</p>",
