{%- comment -%}
  Vitrine — les avis 5 etoiles avec photo (213 en reserve).
  Comme l'application, on n'en montre qu'une partie a la fois et la fenetre
  glisse au fil du temps : la selection change d'un chargement a l'autre.
{%- endcomment -%}
{%- assign total = 213 -%}
{%- assign fenetre = st.limite | default: 50 -%}
{%- if fenetre > total -%}{%- assign fenetre = total -%}{%- endif -%}
{%- assign dep = 'now' | date: '%s' | modulo: total -%}
{%- render 'velluce-avis-vitrine-top-1', st: st, total: total, fenetre: fenetre, dep: dep -%}
{%- render 'velluce-avis-vitrine-top-2', st: st, total: total, fenetre: fenetre, dep: dep -%}
{%- render 'velluce-avis-vitrine-top-3', st: st, total: total, fenetre: fenetre, dep: dep -%}
{%- render 'velluce-avis-vitrine-top-4', st: st, total: total, fenetre: fenetre, dep: dep -%}
