{%- comment -%}
  Vitrine — tous les avis avec photo (227 en reserve).
  Comme l'application, on n'en montre qu'une partie a la fois et la fenetre
  glisse au fil du temps : la selection change d'un chargement a l'autre.
{%- endcomment -%}
{%- assign total = 227 -%}
{%- assign fenetre = st.limite | default: 50 -%}
{%- if fenetre > total -%}{%- assign fenetre = total -%}{%- endif -%}
{%- assign dep = 'now' | date: '%s' | modulo: total -%}
{%- render 'velluce-avis-vitrine-1', st: st, total: total, fenetre: fenetre, dep: dep -%}
{%- render 'velluce-avis-vitrine-2', st: st, total: total, fenetre: fenetre, dep: dep -%}
{%- render 'velluce-avis-vitrine-3', st: st, total: total, fenetre: fenetre, dep: dep -%}
{%- render 'velluce-avis-vitrine-4', st: st, total: total, fenetre: fenetre, dep: dep -%}
