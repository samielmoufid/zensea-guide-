    {
      "type": "select",
      "id": "scroll_to_block",
      "label": "Au clic, descendre vers",
      "options": [
        { "value": "", "label": "Rien" },
        { "value": "carrousel", "label": "Le carrousel d'avis" }
      ],
      "default": ""
    }
  ],
  "presets": [{ "name": "Étoiles (avis Zensea)" }]
}
{% endschema %}
