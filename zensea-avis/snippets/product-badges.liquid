{%- doc -%}
  Affiche les badges sur l'image du produit (carte + page produit).
  @param {object} product - Le produit
{%- enddoc -%}

{%- liquid
  assign v = product.selected_or_first_available_variant
-%}

<div class="product-badges product-badges--bottom-left">
  {%- if product.available == false and settings.show_sold_out_badge_on_cards -%}
    <div class="badge color-{{ settings.badge_color_scheme_sold_out }}">
      {{ 'products.sold_out' | t }}
    </div>
  {%- endif -%}

  {%- comment -%}
    Le badge « Économiser X € » a été retiré : l'économie est désormais annoncée
    une seule fois, dans le badge à côté du prix.
  {%- endcomment -%}

  {%- if product.metafields.custom.badge -%}
    <div class="badge color-{{ settings.badge_color_scheme_custom }}">
      {{ product.metafields.custom.badge }}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .product-badges {
    position: absolute;
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-xs);
    z-index: 2;
    max-width: calc(100% - 16px);
    pointer-events: none;
  }

  .product-badges--bottom-left {
    bottom: var(--padding-sm);
    left: var(--padding-sm);
    justify-content: flex-start;
  }

  .badge--save-image {
    background-color: #B4C9BE;
    color: #181C1A;
    font-weight: 700;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.01em;
    padding: 5px 9px;
    border: none;
    border-radius: var(--badge-border-radius);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.14);
  }

  /* Un conteneur de badges vide ne doit pas capter d'espace ni de clics. */
  .product-badges:empty {
    display: none;
  }
{% endstylesheet %}
