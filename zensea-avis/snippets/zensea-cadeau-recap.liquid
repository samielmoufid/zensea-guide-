{%- comment -%}
  Zensea — rappel visuel du tongue drum offert.

  Deux rôles :
    1. panier et tiroir de panier : la carte du tongue drum offert sur chaque
       ligne qui porte la propriété, à la place du texte brut ;
    2. barre fixe « Ajouter au panier » : on n'y laisse que le bouton, sur une
       seule ligne.

  Sur la fiche produit, c'est le sélecteur zensea-cadeau-tongue-drum qui affiche
  déjà le coloris choisi et son prix barré : on ne double pas l'information.

  Le choix du coloris est fait par le widget zensea-cadeau-tongue-drum, qui écrit
  la propriété de ligne « Tongue drum offert ». On se contente de la lire.
{%- endcomment -%}

{%- assign zsc_gift = all_products['tongue-drum-debutant-11-notes'] -%}
{%- if zsc_gift != blank and zsc_gift.variants.size > 0 -%}
  {%- assign zsc_prix = zsc_gift.variants.first.price -%}

  <script type="application/json" id="zs-cadeau-data">
    {
      "nom": {{ zsc_gift.title | json }},
      "propriete": "Tongue drum offert",
      "prix": {{ zsc_prix }},
      "prixTexte": {{ zsc_prix | money | json }},
      "imageDefaut": {{ zsc_gift.featured_media | image_url: width: 120 | json }},
      "coloris": [
        {%- for v in zsc_gift.variants -%}
          {
            "titre": {{ v.title | json }},
            "prix": {{ v.price }},
            "prixTexte": {{ v.price | money | json }},
            "image": {% if v.featured_media %}{{ v.featured_media | image_url: width: 120 | json }}{% else %}{{ zsc_gift.featured_media | image_url: width: 120 | json }}{% endif %}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>

  {%- if template.suffix == 'handpan' and product != blank -%}
    <script type="application/json" id="zs-cadeau-produit">
      { "actif": true }
    </script>
  {%- endif -%}

  <style>
    .zs-cr {
      display: flex;
      align-items: center;
      gap: 10px;
      max-width: 470px;
      margin: 10px 0 2px;
      padding: 8px 11px 8px 8px;
      border: 1px dashed #9DBBAC;
      border-radius: 12px;
      background: #F3F7F4;
      box-sizing: border-box;
    }
    .zs-cr__img {
      flex: 0 0 auto;
      width: 38px;
      height: 38px;
      border-radius: 8px;
      overflow: hidden;
      background: #fff;
      border: 1px solid #E3EDE7;
      display: block;
    }
    .zs-cr__img img { width: 100%; height: 100%; object-fit: contain; display: block; }
    .zs-cr__txt { min-width: 0; flex: 1 1 auto; line-height: 1.25; }
    .zs-cr__lab {
      display: block;
      font-size: 9.5px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 700;
      color: #2E5E46;
    }
    .zs-cr__nom {
      display: block;
      margin-top: 2px;
      font-size: 12.5px;
      font-weight: 600;
      color: #22332A;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .zs-cr__px {
      flex: 0 0 auto;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 2px;
      line-height: 1;
    }
    .zs-cr__was { font-size: 10px; color: #8A968F; text-decoration: line-through; white-space: nowrap; }
    .zs-cr__free { font-size: 11.5px; font-weight: 700; color: #2E5E46; white-space: nowrap; }

    /* La barre fixe porte « Ajouter au panier » puis le prix et le prix barré,
       sur une seule ligne. Pas de badge d'économie, pas de bloc cadeau. */
    sticky-add-to-cart .badge--sale { display: none !important; }
    sticky-add-to-cart .zs-cr,
    sticky-add-to-cart .zs-gd { display: none !important; }

    sticky-add-to-cart .button__content {
      display: inline-flex;
      align-items: baseline;
      justify-content: center;
      flex-wrap: nowrap;
      gap: 8px;
      white-space: nowrap;
    }
    sticky-add-to-cart .product-price-container,
    sticky-add-to-cart .price-container {
      display: inline-flex;
      align-items: baseline;
      margin: 0;
    }
    sticky-add-to-cart .prices {
      display: inline-flex;
      align-items: baseline;
      gap: 8px;
      white-space: nowrap;
    }
    sticky-add-to-cart .compare-at-price { opacity: .62; }

    /* Version panier : compacte, et surtout entièrement compressible pour ne
       jamais pousser la quantité ni la croix hors du panier. */
    /* La ligne de panier est une grille ou une rangée flex : on force la carte
       à occuper toute la largeur et à passer en dessous. */
    .cart-drawer__item, .cart__item { flex-wrap: wrap; }

    .zs-cr--panier {
      flex: 1 1 100%;
      flex-basis: 100%;
      grid-column: 1 / -1;
      order: 99;
      width: 100%;
      max-width: 100%;
      min-width: 0;
      margin: 8px 0 0;
      padding: 7px 9px 7px 7px;
      gap: 8px;
      box-sizing: border-box;
    }
    .zs-cr--panier .zs-cr__img { width: 28px; height: 28px; border-radius: 7px; }
    .zs-cr--panier .zs-cr__txt { min-width: 0; flex: 1 1 auto; overflow: hidden; }
    .zs-cr--panier .zs-cr__lab { font-size: 8.5px; letter-spacing: .08em; }
    .zs-cr--panier .zs-cr__nom {
      font-size: 11.5px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .zs-cr--panier .zs-cr__px { flex: 0 0 auto; }
    .zs-cr--panier .zs-cr__was { font-size: 9.5px; }
    .zs-cr--panier .zs-cr__free { font-size: 10.5px; }

    /* Le thème laisse les colonnes du panier grossir : on les borne, sinon la
       quantité et le bouton de suppression sortent du cadre. */
    .cart-drawer__item-content,
    .cart__item-content,
    .cart-drawer__item-wrapper,
    .cart__item-wrapper { min-width: 0; }
    .cart-drawer__item-name,
    .cart__item-name { overflow-wrap: anywhere; }

    @media (max-width: 749px) {
      .zs-cr { max-width: 100%; }
    }
  </style>

  <script>
    (function () {
      var noeud = document.getElementById('zs-cadeau-data');
      if (!noeud) return;
      var D;
      try { D = JSON.parse(noeud.textContent); } catch (e) { return; }
      if (!D || !D.coloris || !D.coloris.length) return;

      var parTitre = {};
      D.coloris.forEach(function (c) { parTitre[c.titre] = c; });

      function euros(centimes) {
        try {
          return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(centimes / 100);
        } catch (e) {
          return (centimes / 100).toFixed(2).replace('.', ',') + ' €';
        }
      }

      function carte(coloris, panier) {
        var c = parTitre[coloris] || D.coloris[0];
        var el = document.createElement('div');
        el.className = 'zs-cr' + (panier ? ' zs-cr--panier' : '');
        el.setAttribute('data-zs-cr', '');
        el.innerHTML =
          '<span class="zs-cr__img"><img src="' + c.image + '" alt="" width="38" height="38" loading="lazy"></span>' +
          '<span class="zs-cr__txt">' +
            '<span class="zs-cr__lab">Offert avec votre handpan</span>' +
            '<span class="zs-cr__nom">' + D.nom + ' · ' + c.titre + '</span>' +
          '</span>' +
          '<span class="zs-cr__px">' +
            '<s class="zs-cr__was">' + c.prixTexte + '</s>' +
            '<b class="zs-cr__free">Offert</b>' +
          '</span>';
        return el;
      }

      /* ---------- 3. les lignes du panier ---------- */
      /* Le tiroir utilise .cart-drawer__item-*, la page panier .cart__item-*.
         On vise la colonne de contenu de la ligne : la carte se pose dessous. */
      /* On vise la LIGNE entière, pas la colonne de texte : sinon la carte se
         retrouve coincée à côté du sélecteur de quantité et s'écrase. */
      var SEL_LIGNE = '.cart-drawer__item, .cart__item, .cart-item, ' +
                      '[class*="line-item"], li, tr';

      function conteneurLigne(el) {
        return (el.closest && el.closest(SEL_LIGNE)) || el.parentElement;
      }

      function poserPanier() {
        var marque = D.propriete;
        var candidats = document.querySelectorAll('dd, dt, li, p, span, div');
        for (var i = 0; i < candidats.length; i++) {
          var el = candidats[i];
          if (el.children.length) continue;
          var t = (el.textContent || '').trim();
          if (t.indexOf(marque) !== 0) continue;

          var val = t.slice(marque.length).replace(/^\s*[:：]\s*/, '').trim();
          if (!val) {
            var frere = el.nextElementSibling;
            if (frere) val = (frere.textContent || '').trim();
            if (frere && val) frere.setAttribute('data-zs-cr-cache', '');
          }
          if (!val) continue;

          /* On masque la ligne d'option entière, pas seulement le libellé. */
          var enveloppe = (el.closest && el.closest('.cart-drawer__item-option, .cart__item-option')) || el;
          enveloppe.setAttribute('data-zs-cr-cache', '');

          var ligne = conteneurLigne(el);
          if (!ligne) continue;
          var deja = ligne.querySelector('[data-zs-cr]');
          if (deja && deja.getAttribute('data-col') === val) continue;
          if (deja) deja.remove();
          var c = carte(val, true);
          c.setAttribute('data-col', val);
          ligne.appendChild(c);
        }
        document.querySelectorAll('[data-zs-cr-cache]').forEach(function (e) { e.style.display = 'none'; });
      }

      function tout() {
        poserPanier();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', tout);
      } else {
        tout();
      }
      document.addEventListener('click', function (e) {
        if (e.target.closest && e.target.closest('.zs-gd__opt')) setTimeout(tout, 40);
      });
      document.addEventListener('shopify:section:load', tout);
      document.addEventListener('variant:change', tout);
      window.setInterval(tout, 900);
    })();
  </script>
{%- endif -%}
