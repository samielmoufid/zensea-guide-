{%- comment -%}
  Zensea — rappel visuel du tongue drum offert.

  Deux rôles :
    1. panier et tiroir de panier : la carte du tongue drum offert sur chaque
       ligne qui porte la propriété, à la place du texte brut ;
    2. barre fixe « Ajouter au panier » : on n'y laisse que le bouton, sur une
       seule ligne.

  Sur la fiche produit, c'est le sélecteur zensea-cadeau-tongue-drum qui affiche
  déjà le coloris choisi et son prix barré : on ne double pas l'information.

  Le choix du coloris est fait par le widget zensea-cadeau-tongue-drum, qui écrit
  la propriété de ligne « Tongue drum offert ». On se contente de la lire.
{%- endcomment -%}

{%- assign zsc_gift = all_products['tongue-drum-debutant-11-notes'] -%}
{%- if zsc_gift != blank and zsc_gift.variants.size > 0 -%}
  {%- assign zsc_prix = zsc_gift.variants.first.price -%}

  <script type="application/json" id="zs-cadeau-data">
    {
      "nom": {{ zsc_gift.title | json }},
      "propriete": "Tongue drum offert",
      "format": {{ shop.money_format | json }},
      "zeros": {% if settings.show_trailing_zeros %}true{% else %}false{% endif %},
      "prix": {{ zsc_prix }},
      "prixTexte": {{ zsc_prix | money | json }},
      "imageDefaut": {{ zsc_gift.featured_media | image_url: width: 120 | json }},
      "coloris": [
        {%- for v in zsc_gift.variants -%}
          {
            "titre": {{ v.title | json }},
            "prix": {{ v.price }},
            "prixTexte": {{ v.price | money | json }},
            "image": {% if v.featured_media %}{{ v.featured_media | image_url: width: 120 | json }}{% else %}{{ zsc_gift.featured_media | image_url: width: 120 | json }}{% endif %}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>

  {%- if template.suffix == 'handpan' and product != blank -%}
    <script type="application/json" id="zs-cadeau-produit">
      { "actif": true }
    </script>
  {%- endif -%}

  <style>
    .zs-cr {
      display: flex;
      align-items: center;
      gap: 10px;
      max-width: 470px;
      margin: 10px 0 2px;
      padding: 8px 11px 8px 8px;
      border: 1px dashed #9DBBAC;
      border-radius: 12px;
      background: #F3F7F4;
      box-sizing: border-box;
    }
    .zs-cr__img {
      flex: 0 0 auto;
      width: 38px;
      height: 38px;
      border-radius: 8px;
      overflow: hidden;
      background: #fff;
      border: 1px solid #E3EDE7;
      display: block;
    }
    .zs-cr__img img { width: 100%; height: 100%; object-fit: contain; display: block; }
    .zs-cr__txt { min-width: 0; flex: 1 1 auto; line-height: 1.25; }
    .zs-cr__lab {
      display: block;
      font-size: 9.5px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 700;
      color: #2E5E46;
    }
    .zs-cr__nom {
      display: block;
      margin-top: 2px;
      font-size: 12.5px;
      font-weight: 600;
      color: #22332A;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .zs-cr__px {
      flex: 0 0 auto;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 2px;
      line-height: 1;
    }
    .zs-cr__was { font-size: 10px; color: #8A968F; text-decoration: line-through; white-space: nowrap; }
    .zs-cr__free { font-size: 11.5px; font-weight: 700; color: #2E5E46; white-space: nowrap; }

    /* La barre fixe porte « Ajouter au panier » puis le prix et le prix barré,
       sur une seule ligne. Pas de badge d'économie, pas de bloc cadeau. */
    sticky-add-to-cart .badge--sale { display: none !important; }
    sticky-add-to-cart .zs-cr,
    sticky-add-to-cart .zs-gd { display: none !important; }

    sticky-add-to-cart .button__content {
      display: inline-flex;
      align-items: baseline;
      justify-content: center;
      flex-wrap: nowrap;
      gap: 8px;
      white-space: nowrap;
    }
    sticky-add-to-cart .product-price-container,
    sticky-add-to-cart .price-container {
      display: inline-flex;
      align-items: baseline;
      margin: 0;
    }
    sticky-add-to-cart .prices {
      display: inline-flex;
      align-items: baseline;
      gap: 8px;
      white-space: nowrap;
    }
    sticky-add-to-cart .compare-at-price { opacity: .62; }

    /* Version panier : compacte, et surtout entièrement compressible pour ne
       jamais pousser la quantité ni la croix hors du panier. */
    /* La ligne de panier est une grille ou une rangée flex : on force la carte
       à occuper toute la largeur et à passer en dessous. */
    .cart-drawer__item, .cart__item { flex-wrap: wrap; }

    .zs-cr--panier {
      flex: 1 1 100%;
      flex-basis: 100%;
      grid-column: 1 / -1;
      order: 99;
      width: 100%;
      max-width: 100%;
      min-width: 0;
      margin: 8px 0 0;
      padding: 7px 9px 7px 7px;
      gap: 8px;
      box-sizing: border-box;
    }
    .zs-cr--panier .zs-cr__img { width: 28px; height: 28px; border-radius: 7px; }
    .zs-cr--panier .zs-cr__txt { min-width: 0; flex: 1 1 auto; overflow: hidden; }
    .zs-cr--panier .zs-cr__lab { font-size: 8.5px; letter-spacing: .08em; }
    .zs-cr--panier .zs-cr__nom {
      font-size: 11.5px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .zs-cr--panier .zs-cr__px { flex: 0 0 auto; }
    .zs-cr--panier .zs-cr__was { font-size: 9.5px; }
    .zs-cr--panier .zs-cr__free { font-size: 10.5px; }

    /* Ligne « cadeau offert » juste au-dessus du total */
    .zs-tt {
      display: flex;
      align-items: center;
      gap: 9px;
      width: 100%;
      box-sizing: border-box;
      margin: 0 0 10px;
      padding: 8px 10px 8px 8px;
      border: 1px dashed #9DBBAC;
      border-radius: 12px;
      background: #F3F7F4;
    }
    .zs-tt .zs-cr__img { width: 28px; height: 28px; }
    .zs-tt .zs-cr__txt { min-width: 0; flex: 1 1 auto; line-height: 1.25; overflow: hidden; }
    .zs-tt .zs-cr__lab { font-size: 8.5px; letter-spacing: .08em; }
    .zs-tt .zs-cr__nom { font-size: 11.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .zs-tt .zs-cr__px { flex: 0 0 auto; }
    .zs-tt .zs-cr__was { font-size: 9.5px; }
    .zs-tt .zs-cr__free { font-size: 10.5px; }

    /* Le thème laisse les colonnes du panier grossir : on les borne, sinon la
       quantité et le bouton de suppression sortent du cadre. */
    .cart-drawer__item-content,
    .cart__item-content,
    .cart-drawer__item-wrapper,
    .cart__item-wrapper { min-width: 0; }
    .cart-drawer__item-name,
    .cart__item-name { overflow-wrap: anywhere; }

    @media (max-width: 749px) {
      .zs-cr { max-width: 100%; }
    }

    /* Ligne de panier : vignette à gauche, titre et prix à sa droite.
       La carte cadeau garde sa ligne entière grâce à flex-basis: 100%. */
    .cart-drawer__item,
    .cart__item {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 12px;
    }
    .cart-drawer__item > a:first-of-type,
    .cart__item > a:first-of-type {
      flex: 0 0 auto;
      width: 78px;
      max-width: 78px;
    }
    .cart-drawer__item > a:first-of-type img,
    .cart__item > a:first-of-type img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 10px;
    }
    .cart-drawer__item-wrapper,
    .cart__item-wrapper {
      flex: 1 1 0;
      min-width: 0;
    }
    .cart-drawer__item-actions,
    .cart__item-actions {
      flex: 0 0 auto;
      margin-left: auto;
    }
    .cart-drawer__item-name,
    .cart__item-name {
      display: block;
      font-size: 13.5px;
      line-height: 1.3;
    }

    /* Bandeau de rassurance : une barre fine, d'un bord à l'autre du panier.
       Les marges latérales négatives sont posées en JS, à la mesure exacte du
       retrait du conteneur. */
    .zs-bd {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      margin: 0 0 12px;
      padding: 6px 14px;
      border-radius: 0;
      background: #2E5E46;
      color: #FBF9F4;
      font-size: 12px;
      line-height: 1.35;
      font-weight: 600;
      text-align: center;
      box-sizing: border-box;
    }
    .zs-bd__et { color: #FBF9F4; font-size: 12px; line-height: 1; }
    /* On colle la barre au titre du panier. */
    .cart-drawer__items,
    .cart__items { padding-top: 0; margin-top: 0; }

    /* Ligne « Livraison — Offerte », entre le cadeau et le total. */
    .zs-lv {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin: 0 0 8px;
      font-size: 13px;
      line-height: 1.3;
      color: #22332A;
    }
    .zs-lv b { color: #2E5E46; font-weight: 700; }

    /* Icônes de paiement : centrées, sous le bouton, visibles aussi sur mobile. */
    cart-drawer .payment-methods,
    .cart-footer-blocks .payment-methods {
      --alignment: center;
      --alignment-mobile: center;
      justify-content: center !important;
      display: flex !important;
      flex-wrap: wrap;
    }
    @media (max-width: 749px) {
      .zs-bd { font-size: 11.5px; padding: 6px 12px; }
      .cart-drawer__item > a:first-of-type,
      .cart__item > a:first-of-type { width: 72px; max-width: 72px; }
    }
  </style>

  <script>
    (function () {
      var noeud = document.getElementById('zs-cadeau-data');
      if (!noeud) return;
      var D;
      try { D = JSON.parse(noeud.textContent); } catch (e) { return; }
      if (!D || !D.coloris || !D.coloris.length) return;

      var parTitre = {};
      D.coloris.forEach(function (c) { parTitre[c.titre] = c; });

      /* On reprend le format monétaire de la boutique, décimales comprises :
         un « 1.339,40 € » maison à côté du « €1.339,40 » du thème se verrait. */
      function euros(centimes) {
        var f = D.format || '\u20ac{{amount_with_comma_separator}}';
        var rond = (centimes % 100) === 0;
        return f.replace(/\{\{\s*(\w+)\s*\}\}/g, function (_, cle) {
          var dec = (cle.indexOf('no_decimals') >= 0 || (!D.zeros && rond)) ? 0 : 2;
          var mille = ',', virgule = '.';
          if (cle.indexOf('comma_separator') >= 0) { mille = '.'; virgule = ','; }
          else if (cle.indexOf('apostrophe_separator') >= 0) { mille = "'"; virgule = '.'; }
          else if (cle.indexOf('space_separator') >= 0) { mille = ' '; virgule = ','; }
          var p = (centimes / 100).toFixed(dec).split('.');
          p[0] = p[0].replace(/\B(?=(\d{3})+(?!\d))/g, mille);
          return p.length > 1 ? p[0] + virgule + p[1] : p[0];
        });
      }

      function carte(coloris, panier) {
        var c = parTitre[coloris] || D.coloris[0];
        var el = document.createElement('div');
        el.className = 'zs-cr' + (panier ? ' zs-cr--panier' : '');
        el.setAttribute('data-zs-cr', '');
        el.innerHTML =
          '<span class="zs-cr__img"><img src="' + c.image + '" alt="" width="38" height="38" loading="lazy"></span>' +
          '<span class="zs-cr__txt">' +
            '<span class="zs-cr__lab">Offert avec votre handpan</span>' +
            '<span class="zs-cr__nom">' + D.nom + ' · ' + c.titre + '</span>' +
          '</span>' +
          '<span class="zs-cr__px">' +
            '<s class="zs-cr__was">' + c.prixTexte + '</s>' +
            '<b class="zs-cr__free">Offert</b>' +
          '</span>';
        return el;
      }

      /* ---------- 3. les lignes du panier ---------- */
      /* Le tiroir utilise .cart-drawer__item-*, la page panier .cart__item-*.
         On vise la colonne de contenu de la ligne : la carte se pose dessous. */
      /* On vise la LIGNE entière, pas la colonne de texte : sinon la carte se
         retrouve coincée à côté du sélecteur de quantité et s'écrase. */
      var SEL_LIGNE = '.cart-drawer__item, .cart__item, .cart-item, ' +
                      '[class*="line-item"], li, tr';

      function conteneurLigne(el) {
        return (el.closest && el.closest(SEL_LIGNE)) || el.parentElement;
      }

      function poserPanier() {
        var marque = D.propriete;
        var candidats = document.querySelectorAll('dd, dt, li, p, span, div');
        for (var i = 0; i < candidats.length; i++) {
          var el = candidats[i];
          if (el.children.length) continue;
          var t = (el.textContent || '').trim();
          if (t.indexOf(marque) !== 0) continue;

          var val = t.slice(marque.length).replace(/^\s*[:：]\s*/, '').trim();
          if (!val) {
            var frere = el.nextElementSibling;
            if (frere) val = (frere.textContent || '').trim();
            if (frere && val) frere.setAttribute('data-zs-cr-cache', '');
          }
          if (!val) continue;

          /* On masque la ligne d'option entière, pas seulement le libellé. */
          var enveloppe = (el.closest && el.closest('.cart-drawer__item-option, .cart__item-option')) || el;
          enveloppe.setAttribute('data-zs-cr-cache', '');

          var ligne = conteneurLigne(el);
          if (!ligne) continue;
          var deja = ligne.querySelector('[data-zs-cr]');
          if (deja && deja.getAttribute('data-col') === val) continue;
          if (deja) deja.remove();
          var c = carte(val, true);
          c.setAttribute('data-col', val);
          ligne.appendChild(c);
        }
        document.querySelectorAll('[data-zs-cr-cache]').forEach(function (e) { e.style.display = 'none'; });
      }

      /* ---------- 4. le pied de panier : ligne cadeau puis total ---------- */
      function cadeauxDuPanier() {
        var n = 0, coloris = null;
        /* La page panier contient ses lignes .cart__item ET celles du tiroir :
           compter les deux doublerait la quantité. On n'en retient qu'un jeu. */
        var lignes = document.querySelectorAll('.cart__item');
        if (!lignes.length) lignes = document.querySelectorAll('.cart-drawer__item');
        lignes.forEach(function (l) {
          var c = l.querySelector('[data-zs-cr]');
          if (!c) return;
          if (!coloris) coloris = c.getAttribute('data-col');
          var q = l.querySelector('input[name="updates[]"], input[type="number"], [data-ref="quantity-input"]');
          var v = q ? parseInt(q.value, 10) : 1;
          n += (isNaN(v) || v < 1) ? 1 : v;
        });
        return { nb: n, coloris: coloris };
      }

      function poserTotal() {
        var g = cadeauxDuPanier();
        document.querySelectorAll('.cart__totals').forEach(function (tot) {
          var lab = tot.querySelector('p');
          if (lab && /Total\s+estim/i.test(lab.textContent)) lab.textContent = 'Total';

          var prixEl = tot.querySelector('.price[data-ref="price"]');
          var cmpEl = tot.querySelector('.compare-at-price[data-ref="compare-at-price"]');
          var badge = tot.querySelector('.badge__savings');
          var pere = tot.parentNode;

          /* Ligne « Livraison — Offerte », juste au-dessus du total. */
          var liv = pere.querySelector(':scope > .zs-lv');
          if (!liv) {
            liv = document.createElement('div');
            liv.className = 'zs-lv';
            liv.innerHTML = '<span>Livraison</span><b>Offerte</b>';
            pere.insertBefore(liv, tot);
          }

          var ligne = pere.querySelector(':scope > [data-zs-tt]');

          if (!g.nb) {
            if (ligne) ligne.remove();
            return;
          }

          var c = parTitre[g.coloris] || D.coloris[0];
          var nom = D.nom + ' · ' + c.titre + (g.nb > 1 ? ' × ' + g.nb : '');
          if (!ligne) {
            ligne = document.createElement('div');
            ligne.className = 'zs-tt';
            ligne.setAttribute('data-zs-tt', '');
            pere.insertBefore(ligne, liv);
          }
          var voulu =
            '<span class="zs-cr__img"><img src="' + c.image + '" alt="" width="28" height="28" loading="lazy"></span>' +
            '<span class="zs-cr__txt">' +
              '<span class="zs-cr__lab">Cadeau offert avec la commande</span>' +
              '<span class="zs-cr__nom">' + nom + '</span>' +
            '</span>' +
            '<span class="zs-cr__px">' +
              '<s class="zs-cr__was">' + euros(D.prix * g.nb) + '</s>' +
              '<b class="zs-cr__free">Offert</b>' +
            '</span>';
          if (ligne.innerHTML !== voulu) ligne.innerHTML = voulu;

          /* Le prix barré du total inclut aussi la valeur des tongue drums. */
          if (prixEl && cmpEl) {
            var px = parseInt(prixEl.getAttribute('data-value'), 10) || 0;
            var base = parseInt(cmpEl.getAttribute('data-value'), 10) || 0;
            if (base < px) base = px;
            var total = base + D.prix * g.nb;
            var txt = euros(total);
            if (cmpEl.textContent.trim() !== txt) cmpEl.textContent = txt;
            if (badge) {
              var eco = '-' + euros(total - px);
              if (badge.textContent.trim() !== eco) badge.textContent = eco;
              var enveloppe = badge.closest('.badge');
              if (enveloppe) enveloppe.style.display = '';
            }
          }
        });
      }

      /* ---------- 5. bandeau en haut du panier ---------- */
      /* Le retrait ne vient pas forcément du parent direct : on mesure l'écart
         réel entre la barre et le bord du tiroir, et on le compense. */
      function caler(bd) {
        /* Le panneau visible du tiroir : le dernier élément avant <cart-drawer>,
           celui qui porte le retrait intérieur. Pas l'enveloppe plein écran. */
        var tiroir = bd.closest('cart-drawer, .cart-drawer');
        var cadre = null;
        if (tiroir) {
          var e = bd.parentElement;
          while (e && e.parentElement && e.parentElement !== tiroir) e = e.parentElement;
          cadre = e;
        }
        bd.style.marginLeft = '';
        bd.style.marginRight = '';
        bd.style.marginTop = '';
        var ref = cadre || bd.parentNode;
        var rb = bd.getBoundingClientRect();
        var rc = ref.getBoundingClientRect();
        if (!rb.width || !rc.width) return;
        var g = Math.round(rb.left - rc.left);
        var d = Math.round(rc.right - rb.right);
        if (g > 0) bd.style.marginLeft = (-g) + 'px';
        if (d > 0) bd.style.marginRight = (-d) + 'px';
        /* Puis on la colle au titre du panier. */
        var tete = tiroir ? tiroir.querySelector('.cart-drawer__header, header') : null;
        if (tete) {
          var h = Math.round(bd.getBoundingClientRect().top - tete.getBoundingClientRect().bottom);
          if (h > 4) bd.style.marginTop = (4 - h) + 'px';
        }
      }

      function poserBandeau() {
        document.querySelectorAll('.cart-drawer__items, .cart__items').forEach(function (zone) {
          var avant = zone.previousElementSibling;
          if (avant && avant.classList && avant.classList.contains('zs-bd')) return;
          if (!zone.querySelector('.cart-drawer__item, .cart__item')) return;
          var bd = document.createElement('div');
          bd.className = 'zs-bd';
          bd.innerHTML = '<span class="zs-bd__et" aria-hidden="true">\u2726</span>' +
                         '<span>Votre panier est pr\u00eat \u2014 plus qu\u2019une \u00e9tape.</span>';
          zone.parentNode.insertBefore(bd, zone);
          caler(bd);
        });
      }

      function tout() {
        poserBandeau();
        document.querySelectorAll('.zs-bd').forEach(caler);
        poserPanier();
        poserTotal();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', tout);
      } else {
        tout();
      }
      document.addEventListener('click', function (e) {
        if (e.target.closest && e.target.closest('.zs-gd__opt')) setTimeout(tout, 40);
      });
      document.addEventListener('shopify:section:load', tout);
      document.addEventListener('variant:change', tout);
      window.setInterval(tout, 900);
    })();
  </script>
{%- endif -%}
