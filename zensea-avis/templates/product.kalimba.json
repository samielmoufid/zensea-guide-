        "cc_delivery": {
          "type": "custom-code",
          "settings": {
            "show_on_display": "desktop_and_mobile",
            "custom_liquid": "<style>\n  .zensea-delivery-line {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    margin: 10px 0;\n    color: #2E5E46;\n    font-size: 13.5px;\n    font-weight: 700;\n    line-height: 1.15;\n    white-space: nowrap;\n    max-width: 100%;\n    overflow: hidden;\n  }\n\n  .zensea-delivery-dot {\n    width: 9px;\n    height: 9px;\n    border-radius: 50%;\n    background: #2E5E46;\n    flex-shrink: 0;\n    position: relative;\n    animation: zenseaBlink 1.3s infinite;\n  }\n\n  .zensea-delivery-dot::after {\n    content: \"\";\n    position: absolute;\n    inset: -5px;\n    border-radius: 50%;\n    background: rgba(46, 94, 70, 0.22);\n    animation: zenseaPulse 1.3s infinite;\n  }\n\n  .zensea-delivery-text {\n    color: #2E5E46;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n\n  .zensea-delivery-date {\n    font-weight: 800;\n  }\n\n  @keyframes zenseaBlink {\n    0%, 100% {\n      opacity: 1;\n      transform: scale(1);\n    }\n    50% {\n      opacity: 0.45;\n      transform: scale(0.85);\n    }\n  }\n\n  @keyframes zenseaPulse {\n    0% {\n      transform: scale(0.7);\n      opacity: 0.55;\n    }\n    70% {\n      transform: scale(1.45);\n      opacity: 0;\n    }\n    100% {\n      transform: scale(1.45);\n      opacity: 0;\n    }\n  }\n\n  @media screen and (max-width: 480px) {\n    .zensea-delivery-line {\n      font-size: 11.8px;\n      gap: 5px;\n      margin: 9px 0;\n    }\n\n    .zensea-delivery-dot {\n      width: 8px;\n      height: 8px;\n    }\n  }\n</style>\n\n<div class=\"zensea-delivery-line\" data-zensea-delivery>\n  <span class=\"zensea-delivery-dot\"></span>\n  <span class=\"zensea-delivery-text\">\n    Expédié sous 24 à 48 h ouvrées · livré\n    <span class=\"zensea-delivery-date\" data-date-start></span>&nbsp;-&nbsp;<span class=\"zensea-delivery-date\" data-date-end></span>\n  </span>\n</div>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    document.querySelectorAll(\"[data-zensea-delivery]\").forEach(function (block) {\n      var startElement = block.querySelector(\"[data-date-start]\");\n      var endElement = block.querySelector(\"[data-date-end]\");\n\n      if (!startElement || !endElement) return;\n\n      var startDate = new Date();\n      var endDate = new Date();\n\n      startDate.setDate(startDate.getDate() + 7);\n      endDate.setDate(endDate.getDate() + 13);\n\n      var sameMonth = startDate.getMonth() === endDate.getMonth() &&\n                      startDate.getFullYear() === endDate.getFullYear();\n\n      var shortMonth = {\n        day: \"numeric\",\n        month: \"short\"\n      };\n\n      if (sameMonth) {\n        startElement.textContent = startDate.getDate();\n        endElement.textContent = endDate.toLocaleDateString(\"fr-FR\", shortMonth).replace(\".\", \"\");\n      } else {\n        startElement.textContent = startDate.toLocaleDateString(\"fr-FR\", shortMonth).replace(\".\", \"\");\n        endElement.textContent = endDate.toLocaleDateString(\"fr-FR\", shortMonth).replace(\".\", \"\");\n      }\n    });\n  });\n</script>",
