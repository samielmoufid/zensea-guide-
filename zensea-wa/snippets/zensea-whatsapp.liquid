{%- comment -%}
  ZENSEA — Widget WhatsApp SAV (bas a gauche)
  Rendu depuis layout/theme.liquid : {% render 'zensea-whatsapp' %}
{%- endcomment -%}

{%- liquid
  assign wa_link = 'https://wa.me/message/V5U35J5ZWYZOA1'
  assign wa_glyph = 'zensea-wa-glyph.png' | asset_url
  assign wa_ava = 'zensea-sav-ibtissam.jpg' | asset_url

  if template.name == 'product' and product != blank
    assign wa_name = product.title | split: '—' | first | strip
    assign wa_question = 'Une question sur ' | append: wa_name | append: ' ?'
    assign wa_court = wa_name | truncate: 20, '…'
    assign wa_label = 'Une question sur ' | append: wa_court | append: ' ?'
  else
    assign wa_question = 'Une question sur un produit ?'
    assign wa_label = 'Une question ? Cliquez ici'
  endif
-%}

<div class="zn-wa" data-zn-wa hidden>

  <div class="zn-wa__panel" data-zn-panel role="dialog" aria-label="Contacter le service client Zensea">
    <div class="zn-wa__head">
      <button class="zn-wa__x" type="button" data-zn-close aria-label="Fermer">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"><path d="M5 5l14 14M19 5L5 19"/></svg>
      </button>
      <span class="zn-wa__ava">
        <img src="{{ wa_ava }}" alt="Ibtissam, service client Zensea" width="46" height="46" loading="lazy">
        <i class="zn-wa__dot"></i>
      </span>
      <span class="zn-wa__id">
        <strong>Ibtissam</strong>
        <em>Service client Zensea</em>
      </span>
    </div>

    <div class="zn-wa__body">
      <div class="zn-wa__msg">
        <p>Bonjour, c{{ "'" }}est Ibtissam.</p>
        <p>{{ wa_question }} Écrivez-moi, je vous réponds directement.</p>
        <span class="zn-wa__time">En ligne</span>
      </div>
    </div>

    <div class="zn-wa__foot">
      <a class="zn-wa__go" href="{{ wa_link }}" target="_blank" rel="noopener nofollow">
        <img src="{{ wa_glyph }}" alt="" width="20" height="20" loading="lazy">
        Discuter sur WhatsApp
      </a>
      <span class="zn-wa__note">Spécialiste de nos instruments · Réponse rapide 7j/7</span>
    </div>
  </div>

  <div class="zn-wa__row">
    <button class="zn-wa__btn" type="button" data-zn-toggle aria-label="{{ wa_question | escape }} Contacter le service client sur WhatsApp">
      <img src="{{ wa_glyph }}" alt="" width="32" height="32">
    </button>

    {%- comment -%} Phrase visible en permanence : beaucoup de visiteurs ne cliquent pas sur une simple icone. {%- endcomment -%}
    <button class="zn-wa__label" type="button" data-zn-toggle>
      <span>{{ wa_label }}</span>
      <i class="zn-wa__lx" data-zn-label-close role="button" tabindex="0" aria-label="Masquer ce message">
        <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"><path d="M5 5l14 14M19 5L5 19"/></svg>
      </i>
    </button>
  </div>
</div>

<style>
  .zn-wa{ position:fixed; left:22px; bottom:22px; z-index:9998; display:flex; flex-direction:column; align-items:flex-start; gap:12px; font-family:inherit; pointer-events:none; }
  .zn-wa[hidden]{ display:none; }
  .zn-wa > *{ pointer-events:auto; }

  /* --- Panneau deroulant --- */
  .zn-wa__panel{ width:304px; max-width:calc(100vw - 44px); background:#fff; border-radius:18px; overflow:hidden; box-shadow:0 20px 48px rgba(0,0,0,.20), 0 4px 12px rgba(0,0,0,.08); transform-origin:0 100%; opacity:0; transform:translateY(14px) scale(.94); pointer-events:none; transition:opacity .28s ease, transform .3s cubic-bezier(.34,1.26,.64,1); }
  .zn-wa.is-panel .zn-wa__panel{ opacity:1; transform:translateY(0) scale(1); pointer-events:auto; }
  .zn-wa:not(.is-panel) .zn-wa__panel{ position:absolute; bottom:86px; left:0; }

  .zn-wa__head{ position:relative; display:flex; align-items:center; gap:12px; padding:16px 44px 16px 16px; background:linear-gradient(135deg,#128C4A 0%,#1EA95C 55%,#25D366 100%); color:#fff; }
  .zn-wa__ava{ position:relative; flex:0 0 46px; width:46px; height:46px; }
  .zn-wa__ava img{ width:46px; height:46px; border-radius:50%; object-fit:cover; display:block; box-shadow:0 0 0 2px rgba(255,255,255,.85); }
  .zn-wa__dot{ position:absolute; right:0; bottom:1px; width:12px; height:12px; border-radius:50%; background:#5CEB8E; box-shadow:0 0 0 2.5px #17974F; }
  .zn-wa__id{ display:flex; flex-direction:column; line-height:1.28; min-width:0; }
  .zn-wa__id strong{ font-size:15.5px; font-weight:600; letter-spacing:-.005em; }
  .zn-wa__id em{ font-style:normal; font-size:12.5px; opacity:.88; }
  .zn-wa__x{ position:absolute; top:12px; right:12px; width:26px; height:26px; display:flex; align-items:center; justify-content:center; padding:0; border:0; border-radius:50%; cursor:pointer; background:rgba(255,255,255,.16); color:#fff; transition:background .2s ease; }
  .zn-wa__x:hover{ background:rgba(255,255,255,.3); }

  .zn-wa__body{ padding:18px 16px 16px; background:#EFE7DE; }
  .zn-wa__msg{ position:relative; background:#fff; border-radius:4px 14px 14px 14px; padding:11px 13px 20px; box-shadow:0 1px 2px rgba(0,0,0,.12); }
  .zn-wa__msg p{ margin:0 0 5px; font-size:14px; line-height:1.45; color:#1f2c33; }
  .zn-wa__msg p:last-of-type{ margin-bottom:0; }
  .zn-wa__time{ position:absolute; right:11px; bottom:6px; font-size:10.5px; color:#8a9199; }

  .zn-wa__foot{ padding:14px 16px 16px; background:#fff; text-align:center; }
  .zn-wa__go{ display:flex; align-items:center; justify-content:center; gap:9px; width:100%; padding:12px 14px; border-radius:11px; background:linear-gradient(180deg,#2ED26A 0%,#14A054 100%); color:#fff; font-size:14.5px; font-weight:600; text-decoration:none; box-shadow:0 6px 14px rgba(11,110,55,.3); transition:transform .18s ease, box-shadow .18s ease; }
  .zn-wa__go:hover{ transform:translateY(-1px); box-shadow:0 9px 20px rgba(11,110,55,.36); }
  .zn-wa__note{ display:block; margin-top:9px; font-size:11.5px; color:#8a8681; }

  /* --- Libelle permanent a cote du bouton --- */
  .zn-wa__row{ display:flex; align-items:center; gap:10px; pointer-events:none; }
  .zn-wa__row > *{ pointer-events:auto; }
  .zn-wa__label{ position:relative; display:flex; align-items:center; max-width:216px; padding:6px 20px 6px 11px; border:1px solid rgba(0,0,0,.06); border-radius:999px; background:#fff; color:#12331f; font:inherit; font-size:11.5px; font-weight:600; line-height:1.2; text-align:left; white-space:nowrap; cursor:pointer; box-shadow:0 8px 20px rgba(0,0,0,.13); transition:transform .18s ease, box-shadow .18s ease, opacity .25s ease; }
  .zn-wa__label > span{ display:block; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .zn-wa__label:hover{ transform:translateY(-1px); box-shadow:0 12px 26px rgba(0,0,0,.18); }
  .zn-wa__label::before{ content:''; flex:0 0 6px; width:6px; height:6px; margin-right:7px; border-radius:50%; background:#25D366; box-shadow:0 0 0 3px rgba(37,211,102,.18); }
  .zn-wa__lx{ position:absolute; top:2px; right:4px; display:flex; align-items:center; justify-content:center; width:14px; height:14px; border-radius:50%; color:#b4b0ab; cursor:pointer; transition:color .18s ease, background .18s ease; }
  .zn-wa__lx:hover{ color:#3d3a36; background:rgba(0,0,0,.06); }
  .zn-wa.is-panel .zn-wa__label{ opacity:0; pointer-events:none; }
  /* Le visiteur a ferme la phrase : il ne reste que l'icone. */
  .zn-wa.is-nolabel .zn-wa__label{ display:none; }

  /* --- Bouton rond 3D --- */
  .zn-wa__btn{ position:relative; display:flex; align-items:center; justify-content:center; width:60px; height:60px; padding:0; border:0; border-radius:50%; cursor:pointer; background:radial-gradient(circle at 34% 26%, #5CEB8E 0%, #2FD968 34%, #22C65B 62%, #12A550 100%); box-shadow:0 10px 24px rgba(11,110,55,.36), 0 3px 8px rgba(0,0,0,.16), inset 0 2px 3px rgba(255,255,255,.55), inset 0 -4px 9px rgba(0,80,38,.34); transition:transform .2s ease, box-shadow .2s ease; -webkit-tap-highlight-color:transparent; }
  .zn-wa__btn img{ width:32px; height:32px; display:block; filter:drop-shadow(0 1px 1px rgba(0,60,28,.35)); }
  .zn-wa__btn::before{ content:''; position:absolute; left:10%; top:7%; width:54%; height:36%; border-radius:50%; pointer-events:none; background:linear-gradient(180deg, rgba(255,255,255,.5), rgba(255,255,255,0)); filter:blur(1px); }
  .zn-wa__btn:hover{ transform:translateY(-3px); box-shadow:0 16px 32px rgba(11,110,55,.44), 0 5px 12px rgba(0,0,0,.2), inset 0 2px 3px rgba(255,255,255,.6), inset 0 -4px 9px rgba(0,80,38,.34); }
  .zn-wa__btn:active{ transform:translateY(-1px) scale(.97); }
  .zn-wa__btn:focus-visible{ outline:3px solid #0b3d24; outline-offset:3px; }
  .zn-wa__btn::after{ content:''; position:absolute; inset:0; border-radius:50%; box-shadow:0 0 0 0 rgba(37,211,102,.5); animation:znWaPulse 3s ease-out 3; pointer-events:none; }
  @keyframes znWaPulse{ 0%{ box-shadow:0 0 0 0 rgba(37,211,102,.5);} 70%{ box-shadow:0 0 0 18px rgba(37,211,102,0);} 100%{ box-shadow:0 0 0 0 rgba(37,211,102,0);} }
  .zn-wa.is-panel .zn-wa__btn::after{ animation:none; }

  @media (max-width:749px){
    .zn-wa{ left:14px; bottom:calc(14px + env(safe-area-inset-bottom,0px)); gap:10px; }
    .zn-wa__btn{ width:54px; height:54px; }
    .zn-wa__btn img{ width:29px; height:29px; }
    .zn-wa__label{ max-width:min(184px,56vw); font-size:11px; padding:6px 18px 6px 10px; }
    .zn-wa:not(.is-panel) .zn-wa__panel{ bottom:78px; }
  }

  @media (prefers-reduced-motion:reduce){
    .zn-wa__panel,.zn-wa__btn,.zn-wa__go,.zn-wa__label{ transition:none; }
    .zn-wa__btn::after{ animation:none; }
  }
</style>

<script>
  (function () {
    var root = document.querySelector('[data-zn-wa]');
    if (!root) return;
    root.hidden = false;

    /* Le badge Google Avis occupe le meme coin et verrouille sa position : on remonte au-dessus. */
    function avoidOverlap() {
      var b = document.getElementById('google-merchantwidget-iframe-wrapper');
      if (!b) return;
      var r = b.getBoundingClientRect();
      if (!r.width || r.left > 280) return;
      root.style.bottom = Math.round((window.innerHeight - r.bottom) + r.height + 14) + 'px';
    }
    avoidOverlap();
    setTimeout(avoidOverlap, 1200);
    setTimeout(avoidOverlap, 3500);
    window.addEventListener('resize', avoidOverlap);

    function openPanel() { root.classList.add('is-panel'); }
    function closePanel() { root.classList.remove('is-panel'); }

    /* Petite croix : on masque la phrase et on s'en souvient pour la visite. */
    var LKEY = 'znWaLabel';
    try { if (sessionStorage.getItem(LKEY) === '0') root.classList.add('is-nolabel'); } catch (e) {}
    var croix = root.querySelector('[data-zn-label-close]');
    if (croix) {
      croix.addEventListener('click', function (e) {
        e.stopPropagation();
        e.preventDefault();
        root.classList.add('is-nolabel');
        try { sessionStorage.setItem(LKEY, '0'); } catch (err) {}
      });
      croix.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); croix.click(); }
      });
    }

    root.querySelectorAll('[data-zn-toggle]').forEach(function (el) {
      el.addEventListener('click', function () {
        if (root.classList.contains('is-panel')) { closePanel(); } else { openPanel(); }
      });
    });

    root.querySelector('[data-zn-close]').addEventListener('click', closePanel);

    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closePanel(); });
    document.addEventListener('click', function (e) {
      if (root.classList.contains('is-panel') && !root.contains(e.target)) closePanel();
    });
  })();
</script>
